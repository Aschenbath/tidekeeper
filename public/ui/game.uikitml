<style>
  .card { width: 42; flex-direction: column; gap: 0.7; padding: 1; background-color: #f3e8ce; border-radius: 1.5; }
  .title { color: #26484e; font-size: 2; font-weight: 700; }
  .body { color: #26484e; font-size: 1.35; }
  .row { flex-direction: row; gap: 0.6; }
  .button { height: 4.3; flex-grow: 1; min-width: 4.3; align-items: center; justify-content: center; background-color: #d5c9af; border-radius: 0.7; color: #26484e; font-size: 1.35; }
  .primary { background-color: #267e80; color: #fffbed; }
  .hidden { display: none; }
</style>
<div id="Card" class="card">
  <span id="MissionTitle" class="title">Tidekeeper / First Letter</span>
  <span id="Status" class="body">Pinch to carry. Poke to select and place.</span>
  <span id="Goal" class="body">Deliver everything by tick 4</span>
  <div id="EditControls" class="row">
    <button id="Undo" class="button">Undo</button>
    <button id="Redo" class="button">Redo</button>
    <button id="Hint" class="button">Hint</button>
    <button id="Restart" class="button">Restart</button>
  </div>
  <div class="row">
    <button id="TideBack" class="button">&lt; Tide</button>
    <span id="Tick" class="body">Tick 0 / 10</span>
    <button id="TideForward" class="button">Tide &gt;</button>
  </div>
  <div id="RunControls" class="row">
    <button id="Launch" class="button primary">Launch</button>
    <button id="Pause" class="button hidden">Pause</button>
    <button id="Stop" class="button hidden">Stop</button>
    <button id="Next" class="button hidden primary">Next</button>
  </div>
  <div id="FailureControls" class="row hidden">
    <button id="FailureUndo" class="button primary">Undo last change</button>
    <button id="Back" class="button">Back to editing</button>
  </div>
  <div class="row">
    <button id="Reach" class="button">Reach: near</button>
    <button id="Move" class="button">Move board</button>
    <button id="Sound" class="button">Sound: on</button>
    <button id="RotateLock" class="button hidden">Turn lock</button>
  </div>
  <div id="MoveControls" class="row hidden">
    <button id="MoveLeft" class="button">Left</button>
    <button id="MoveRight" class="button">Right</button>
    <button id="MoveUp" class="button">Up</button>
    <button id="MoveDown" class="button">Down</button>
  </div>
</div>
